for_window [app_id="spotify"] opacity 0.85

# Firefox
for_window [app_id="Firefox"] opacity 0.85

# Steam
for_window [app_id="steam"] opacity 0.85

# Zed
for_window [app_id="dev.zed.Zed"] opacity 0.85

# Nemo
for_window [app_id="nemo"] opacity 0.85

